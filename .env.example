# gp-work monorepo — переменные окружения
# Локально: cp .env.example .env && cp apps/api/.env.example apps/api/.env

# Frontend (apps/web/.env) — см. apps/web/.env.example
# Backend (apps/api/.env) — см. apps/api/.env.example

# Database Configuration (PostgreSQL)
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=postgres
DATABASE_NAME=gp-work

# Server & URLs
PORT=3002
FRONTEND_URL=http://localhost:5173
API_PUBLIC_URL=http://localhost:3002
DB_MIGRATE=true

# Auth
JWT_SECRET=change-me-in-production
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-in-production
ENABLE_ADMIN_RESET=false
ADMIN_RESET_TOKEN=
ENABLE_SWAGGER=false
APP_COMMIT_SHA=local

# OpenAI AI assistants
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_VISION_MODEL=gpt-4o
OPENAI_ADMIN_MODEL=gpt-4o
OPENAI_WORKER_MODEL=gpt-4o-mini
